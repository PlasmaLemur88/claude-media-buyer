    "deny": [
      "mcp__pipeboard__add_catalog_product",
      "mcp__pipeboard__add_users_to_audience",
      "mcp__pipeboard__archive_custom_conversion",
      "mcp__pipeboard__bulk_create_ad_creatives",
      "mcp__pipeboard__bulk_create_ads",
      "mcp__pipeboard__bulk_update_ads",
      "mcp__pipeboard__bulk_update_adsets",
      "mcp__pipeboard__bulk_update_campaigns",
