      "mcp__pipeboard__update_ad_study",
      "mcp__pipeboard__update_ad_url_tags",
      "mcp__pipeboard__update_ad_video",
      "mcp__pipeboard__update_adset",
      "mcp__pipeboard__update_catalog_product",
      "mcp__pipeboard__update_custom_audience",
      "mcp__pipeboard__update_facebook_page_post",
      "mcp__pipeboard__update_lead_gen_form_status",
      "mcp__pipeboard__update_value_rule_set",
