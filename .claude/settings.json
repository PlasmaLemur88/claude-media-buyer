      "mcp__pipeboard__bulk_upload_ad_videos",
      "mcp__pipeboard__create_ad_delivery_push",
      "mcp__pipeboard__create_ad_study",
      "mcp__pipeboard__create_budget_schedule",
      "mcp__pipeboard__create_carousel_ad_creative",
      "mcp__pipeboard__create_catalog",
      "mcp__pipeboard__create_collection_ad",
      "mcp__pipeboard__create_creatives_from_drive_folder",
      "mcp__pipeboard__create_creatives_from_dropbox_folder",
      "mcp__pipeboard__create_custom_audience",
