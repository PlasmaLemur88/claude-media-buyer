      "mcp__pipeboard__delete_ad_creative",
      "mcp__pipeboard__delete_ad_image",
      "mcp__pipeboard__delete_ad_rule",
      "mcp__pipeboard__delete_ad_study",
      "mcp__pipeboard__delete_ad_video",
      "mcp__pipeboard__delete_budget_schedule",
      "mcp__pipeboard__delete_catalog_products",
      "mcp__pipeboard__delete_custom_audience",
      "mcp__pipeboard__delete_facebook_page_post",
      "mcp__pipeboard__delete_value_rule_set",
      "mcp__pipeboard__duplicate_ad",
      "mcp__pipeboard__duplicate_adset",
