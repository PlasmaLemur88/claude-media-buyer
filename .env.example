# Copy to .env and fill in. .env is gitignored. Never commit a key, never paste one in chat.
# Running ads needs none of these. Making new videos needs a video provider. Good options are
# fal, Replicate and Higgsfield; their prices work differently, so pick what suits you.
# This engine's voice and lip-sync scripts call fal; its stills and generated footage call
# Replicate. Higgsfield works through its own Claude connector for stills and clips.
#
# Replicate: stills and video (GPT Image 2, Nano Banana, Seedance, Wan). https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# fal: voices (MiniMax, ElevenLabs v3), sync.so lip-sync, Seedance. https://fal.ai/dashboard/keys
FAL_KEY=
# Google AI Studio: Gemini voices, watching videos, Nano Banana images. https://aistudio.google.com/apikey
GEMINI_API_KEY=
